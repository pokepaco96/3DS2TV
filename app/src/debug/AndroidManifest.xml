<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY: hardware-lab automation via adb (tools/hardware-lab). Not merged into release.
     android.permission.DUMP is held by `adb shell` but not grantable to normal apps. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".lab.LabControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.threedstwo.tv.debug.START" />
                <action android:name="com.threedstwo.tv.debug.STOP" />
                <action android:name="com.threedstwo.tv.debug.EXPORT_METRICS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
